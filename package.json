{
  "name": "wego-fingertip-3d-web",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-kernel.mjs",
    "e2e": "node scripts/e2e.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "cross-env WEGO_DEV_URL=http://127.0.0.1:5175 electron desktop/main.cjs",
    "pack": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "occt-wasm": "^5.6.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "puppeteer-core": "^25.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.wego.cad",
    "productName": "Wego CAD",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "desktop/**/*",
      "dist/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Wego CAD"
    },
    "portable": {
      "artifactName": "WegoCAD-portable.exe"
    }
  }
}
